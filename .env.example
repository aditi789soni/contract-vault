# Application
PORT=3000
NODE_ENV=development

# PostgreSQL 16 Database with RLS
DATABASE_URL="postgresql://app_user:app_password@localhost:5432/contract_vault?schema=public"
DATABASE_ADMIN_URL="postgresql://postgres:postgres@localhost:5432/contract_vault?schema=public"

# JWT Authentication
JWT_ACCESS_SECRET="super-secret-enterprise-access-key-change-in-prod"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="super-secret-enterprise-refresh-key-change-in-prod"
JWT_REFRESH_EXPIRATION="7d"

# AWS S3 / MinIO Object Storage
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET_NAME="contracts"
S3_FORCE_PATH_STYLE="true"
